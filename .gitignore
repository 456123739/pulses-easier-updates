# Python 字节码缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境目录
venv/
.venv/
env/

# IDE 配置文件
.vscode/
.idea/

# 环境变量文件（包含敏感密钥，严禁上传）
.env

# 打包构建输出
dist/
build/
DATABASE-TEST/
resources/
*.egg-info/

# Jupyter Notebook 检查点
.ipynb_checkpoints/

# 测试用的自签证书与临时产物
tests/_tls/
# 测试运行日志（每次都重新生成，不纳入版本库；结论汇总在
# docs/测试记录-v0.5.0.md 与 CHANGELOG.md 里）
tests/logs/

# 真实网络实测的临时下载目录
_realworld/

# 发布包验证的临时工作目录
_verify/
