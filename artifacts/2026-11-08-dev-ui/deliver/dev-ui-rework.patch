+  height: 24px;
+  padding: 0 7px;
+  border: 1px solid transparent;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--c-text-2);
+  font-size: 11.5px;
+  font-family: var(--font-mono);
+  line-height: 1;
+  cursor: pointer;
+  transition: background 140ms var(--ease-out), color 140ms var(--ease-out);
+}
+
+.tool:hover:not(:disabled) {
+  background: var(--mat-3);
+  color: var(--c-text);
+}
+
+.tool[data-on='true'] {
+  background: var(--c-accent-soft);
+  border-color: var(--c-accent-line);
+  color: var(--c-accent-text);
+}
+
+.tool:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+
+.linkRow {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+}
+
+.area {
+  position: relative;
+  min-height: 320px;
+  max-height: min(52vh, 460px);
+  overflow: auto;
+  padding: 16px 20px;
+  border: 1px solid var(--hairline);
+  border-radius: 12px;
+  background: var(--c-card);
+  cursor: text;
+}
+
+.previewArea {
+  cursor: default;
+}
+
+.placeholder {
+  position: absolute;
+  top: 16px;
+  left: 20px;
+  right: 20px;
+  color: var(--c-muted);
+  font-size: var(--fs-body);
+  pointer-events: none;
+}
+
+/* ---- 富文本区（Tiptap / ProseMirror） ---- */
+.prose {
+  outline: none;
+  color: var(--c-text);
+  font-size: var(--fs-body);
+  line-height: 1.65;
+}
+
+.prose :global(p) {
+  margin: 0 0 8px;
+}
+
+.prose :global(h1) {
+  margin: 2px 0 10px;
+  font-size: 19px;
+  font-weight: 620;
+  font-family: var(--font-display);
+}
+
+.prose :global(h2) {
+  margin: 14px 0 8px;
+  font-size: 16px;
+  font-weight: 600;
+  font-family: var(--font-display);
+}
+
+.prose :global(h3) {
+  margin: 12px 0 6px;
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--c-text);
+}
+
+.prose :global(ul),
+.prose :global(ol) {
+  margin: 0 0 8px;
+  padding-left: 20px;
+}
+
+.prose :global(li) {
+  margin: 3px 0;
+}
+
+.prose :global(li p) {
+  margin: 0;
+}
+
+.prose :global(blockquote) {
+  margin: 0 0 10px;
+  padding: 2px 0 2px 12px;
+  border-left: 2px solid var(--hairline-strong);
+  color: var(--c-text-2);
+}
+
+.prose :global(pre) {
+  margin: 0 0 10px;
+  padding: 10px 12px;
+  border: 1px solid var(--hairline);
+  border-radius: 8px;
+  background: var(--c-log);
+  font-family: var(--font-mono);
+  font-size: var(--fs-small);
+  white-space: pre-wrap;
+}
+
+.prose :global(code) {
+  font-family: var(--font-mono);
+  font-size: var(--fs-small);
+  color: var(--c-accent-text);
+}
+
+.prose :global(a) {
+  color: var(--c-accent-text);
+  text-decoration: underline;
+  text-underline-offset: 2px;
+}
+
+.prose :global(hr) {
+  margin: 14px 0;
+  border: none;
+  border-top: 1px solid var(--hairline);
+}
+
+.prose :global(strong) {
+  font-weight: 620;
+}
+
+.source {
+  min-height: 320px;
+  max-height: min(52vh, 460px);
+  padding: 14px 16px;
+  border: 1px solid var(--hairline);
+  border-radius: 12px;
+  background: var(--c-log);
+  color: var(--c-text-2);
+  font-family: var(--font-mono);
+  font-size: 12px;
