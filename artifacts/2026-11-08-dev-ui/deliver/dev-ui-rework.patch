@@ -0,0 +1,165 @@
+"""pack_source.classify —— 开发者端 STEP 1 的"这是什么"判断。
+
+重点不只是判对，还要证明它**便宜**：只读中央目录/目录项，不读成员内容。
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+from unittest import mock
+
+from app.core import pack_source
+
+
+def _write(path: Path, text: str = "x") -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+
+
+def _zip(path: Path, names: list[str], members: dict[str, str] | None = None) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as zf:
+        for name in names:
+            zf.writestr(name, (members or {}).get(name, ""))
+    return path
+
+
+class ClassifyCase(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp(prefix="pe-src-"))
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        self.pack = self.tmp / "versions" / "DemoPack"
+        (self.pack / "mods").mkdir(parents=True)
+        (self.pack / "config").mkdir()
+        _write(self.pack / "mods" / "sodium.jar", "J")
+
+    # ---- 目录 ----
+    def test_instance_dir(self):
+        ref = pack_source.classify(self.pack)
+        self.assertEqual(ref.kind, pack_source.KIND_INSTANCE)
+        self.assertEqual(Path(ref.root), self.pack.resolve())
+        self.assertEqual(ref.label, "DemoPack")
+
+    def test_nested_dir_walks_up(self):
+        ref = pack_source.classify(self.pack / "mods")
+        self.assertEqual(ref.kind, pack_source.KIND_INSTANCE)
+        self.assertEqual(Path(ref.root), self.pack.resolve())
+
+    def test_any_file_inside_pack_walks_up(self):
+        """和侧边栏一样：选整合包里的任意文件也算定位到整合包。"""
+        ref = pack_source.classify(self.pack / "mods" / "sodium.jar")
+        self.assertEqual(ref.kind, pack_source.KIND_INSTANCE)
+        self.assertEqual(Path(ref.root), self.pack.resolve())
+
+    def test_dir_without_mods_config(self):
+        bare = self.tmp / "bare"
+        bare.mkdir()
+        with self.assertRaises(pack_source.SourceError) as ctx:
+            pack_source.classify(bare)
+        self.assertEqual(ctx.exception.code, "NOT_A_PACK")
+        self.assertIn("mods", ctx.exception.message)
+
+    # ---- zip ----
+    def test_zip_with_index(self):
+        path = _zip(self.tmp / "ok.zip", ["modrinth.index.json", "overrides/mods/a.jar"])
+        ref = pack_source.classify(path)
+        self.assertEqual(ref.kind, pack_source.KIND_ZIP)
+        self.assertEqual(ref.label, "ok")
+        self.assertEqual(ref.entries, 2)
+
+    def test_mrpack_suffix_and_nested_index(self):
+        path = _zip(self.tmp / "pack.mrpack",
+                    ["DemoPack/modrinth.index.json", "DemoPack/overrides/config/a.toml"])
+        ref = pack_source.classify(path)
+        self.assertEqual(ref.kind, pack_source.KIND_ZIP)
+
+    def test_zip_without_index_is_rejected(self):
+        path = _zip(self.tmp / "curseforge.zip", ["manifest.json", "overrides/mods/a.jar"])
+        with self.assertRaises(pack_source.SourceError) as ctx:
+            pack_source.classify(path)
+        self.assertEqual(ctx.exception.code, "NOT_A_PACK")
+        self.assertIn("modrinth.index.json", ctx.exception.message)
+
+    def test_broken_zip(self):
+        path = self.tmp / "broken.zip"
+        path.write_bytes(b"not a zip at all")
+        with self.assertRaises(pack_source.SourceError) as ctx:
+            pack_source.classify(path)
+        self.assertEqual(ctx.exception.code, "BAD_ZIP")
+
+    # ---- 明确的"拖错了" ----
+    def test_update_pack_is_rejected_with_reason(self):
+        path = self.tmp / "DemoPack_update.eapack"
+        path.write_bytes(b"PK\x03\x04")
+        with self.assertRaises(pack_source.SourceError) as ctx:
+            pack_source.classify(path)
+        self.assertEqual(ctx.exception.code, "IS_UPDATE_PACK")
+        self.assertIn("更新包", ctx.exception.message)
+
+    def test_unknown_suffix(self):
+        path = self.tmp / "notes.txt"
+        path.write_text("hi", encoding="utf-8")
+        with self.assertRaises(pack_source.SourceError) as ctx:
+            pack_source.classify(path)
+        self.assertEqual(ctx.exception.code, "NOT_SUPPORTED")
+
+    def test_missing_path(self):
+        with self.assertRaises(pack_source.SourceError) as ctx:
+            pack_source.classify(self.tmp / "nope")
+        self.assertEqual(ctx.exception.code, "NOT_FOUND")
+
+    def test_empty_input(self):
+        with self.assertRaises(pack_source.SourceError) as ctx:
+            pack_source.classify("   ")
+        self.assertEqual(ctx.exception.code, "INVALID_INPUT")
+
+    # ---- "便宜"是硬要求 ----
+    def test_never_reads_zip_members(self):
+        """判断阶段绝不能解压：成员读取一律炸掉，classify 仍要成功。"""
+        path = _zip(self.tmp / "big.zip",
+                    ["modrinth.index.json"] + [f"overrides/mods/m{i}.jar" for i in range(3000)])
+        boom = mock.Mock(side_effect=AssertionError("classify 不该读包内成员"))
+        with mock.patch.object(zipfile.ZipFile, "read", boom), \
+                mock.patch.object(zipfile.ZipFile, "open", boom), \
+                mock.patch.object(zipfile.ZipFile, "extract", boom), \
+                mock.patch.object(zipfile.ZipFile, "extractall", boom):
+            ref = pack_source.classify(path)
+        self.assertEqual(ref.kind, pack_source.KIND_ZIP)
+        self.assertEqual(ref.entries, 3001)
+        self.assertFalse(boom.called)
+
+    def test_too_many_entries_is_rejected_cheaply(self):
+        path = _zip(self.tmp / "huge.zip",
+                    ["modrinth.index.json"] + [f"f{i}" for i in range(50)])
+        with mock.patch.object(pack_source, "MAX_ENTRIES", 10):
+            with self.assertRaises(pack_source.SourceError) as ctx:
+                pack_source.classify(path)
+        self.assertEqual(ctx.exception.code, "TOO_MANY_ENTRIES")
+
+
+class IndexFixtureCase(unittest.TestCase):
+    """真 index 的最小合法形状（保证 classify 与 parse_mrpack 判据一致）。"""
+
+    def test_real_index_json_is_recognised(self):
+        tmp = Path(tempfile.mkdtemp(prefix="pe-src2-"))
+        self.addCleanup(shutil.rmtree, tmp, True)
+        index = {
+            "formatVersion": 1, "game": "minecraft", "name": "Demo",
+            "versionId": "1.0.0", "files": [],
+            "dependencies": {"minecraft": "1.20.1"},
+        }
+        path = tmp / "real.mrpack"
+        with zipfile.ZipFile(path, "w") as zf:
+            zf.writestr("modrinth.index.json", json.dumps(index))
+        ref = pack_source.classify(path)
+        self.assertEqual(ref.kind, pack_source.KIND_ZIP)
+        self.assertEqual(ref.note, "modrinth")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_web_dev_open.py b/tests/test_web_dev_open.py
new file mode 100644
index 0000000..c34849b
--- /dev/null
+++ b/tests/test_web_dev_open.py
@@ -0,0 +1,236 @@
+"""开发者端 STEP 1 的唯一入口 dev.open：快判断 + 后台识别 + 角色路由。
+
+要证明的三件事：
+1. 拖/选完立刻返回（phase=loading），不把界面卡在点击上；
+2. 识别完自己把状态推到位；晚到的旧结果不会覆盖新结果；
+3. 认错东西（.eapack / 没有 index 的 zip）要说清原因，并且不动已有来源。
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import tempfile
+import threading
+import time
+import unittest
+import zipfile
+from pathlib import Path
+from unittest import mock
+
+from app.core import database as db
+from app.core import instance_scan
+from app.ui_web.api import Api
+from app.ui_web.controller import AppController
+from app.ui_web.events import EventBus
+
+
+def _write(p: Path, text: str = "x") -> None:
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(text, encoding="utf-8")
+
+
+class DevOpenCase(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp(prefix="pe-devopen-"))
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        dbdir = self.tmp / "db"
+        db.create_database(dbdir)
+        self._appcfg = mock.patch.object(db, "_APP_CFG", self.tmp / "app-config.json")
+        self._appcfg.start()
+        self.addCleanup(self._appcfg.stop)
+        db.set_db_path(dbdir)
+
+        # 实例：mods/ + config/ + 一个根散文件
+        self.pack = self.tmp / "versions" / "DemoPack"
+        _write(self.pack / "mods" / "a.jar", "A")
+        _write(self.pack / "config" / "c.toml", "c = 1\n")
+        _write(self.pack / "options.txt", "fov:90\n")
+
+        self.pack2 = self.tmp / "versions" / "Second"
+        _write(self.pack2 / "mods" / "b.jar", "B")
+        _write(self.pack2 / "config" / "d.toml", "d = 2\n")
+
+        # Modrinth 导出包
+        self.zip_path = self.tmp / "DemoPack-1.0.0.mrpack"
+        with zipfile.ZipFile(self.zip_path, "w") as zf:
+            zf.writestr("modrinth.index.json", json.dumps({
+                "formatVersion": 1, "game": "minecraft", "name": "DemoPack",
+                "versionId": "1.0.0", "files": [],
+                "dependencies": {"minecraft": "1.20.1"}}))
+            zf.writestr("overrides/mods/a.jar", "A")
+            zf.writestr("overrides/config/c.toml", "c = 1\n")
+
+        # 坏 index（能过 classify，但 parse_mrpack 会失败）
+        self.bad_zip = self.tmp / "BadIndex.mrpack"
+        with zipfile.ZipFile(self.bad_zip, "w") as zf:
+            zf.writestr("modrinth.index.json", "{ not json")
+            zf.writestr("overrides/mods/a.jar", "A")
+
+        # 误拖的更新包
+        self.eapack = self.tmp / "Demo_update.eapack"
+        self.eapack.write_bytes(b"PK\x03\x04")
+
+        self.bus = EventBus()
+        self.ctl = AppController(self.bus)
+        self.api = Api(self.ctl, self.bus)
+
+    # ---- 小工具 ----
+    def dev(self) -> dict:
+        res = self.api.invoke("dev.state", {})
+        self.assertTrue(res["ok"], res)
+        return res["data"]
+
+    def wait_idle(self, timeout: float = 8.0) -> dict:
+        end = time.time() + timeout
+        snap = self.dev()
+        while time.time() < end:
+            snap = self.dev()
+            if snap["phase"] != "loading":
+                return snap
+            time.sleep(0.02)
+        self.fail(f"识别没有结束：{snap}")
+
+    def open(self, path) -> dict:
+        res = self.api.invoke("dev.open", {"path": str(path)})
+        self.assertTrue(res["ok"], res)
+        return res["data"]
+
+    # ---- 主路径 ----
+    def test_instance_returns_immediately_then_finishes(self):
+        real = instance_scan.scan_instance
+
+        def slow(*a, **kw):          # 让扫描慢下来，才能看出"没有同步等"
+            time.sleep(0.35)
+            return real(*a, **kw)
+
+        with mock.patch.object(instance_scan, "scan_instance", slow):
+            t0 = time.time()
+            snap = self.open(self.pack)
+            elapsed = time.time() - t0
+        self.assertLess(elapsed, 0.25, "dev.open 同步等了扫描")
+        self.assertEqual(snap["phase"], "loading")
+        self.assertEqual(snap["pending"]["kind"], "instance")
+        self.assertEqual(snap["pending"]["name"], "DemoPack")
+        self.assertTrue(self.ctl.dev.busy())
+
+        done = self.wait_idle()
+        self.assertEqual(done["phase"], "idle")
+        self.assertIsNone(done["pending"])
+        self.assertEqual(done["mode"], "instance")
+        self.assertEqual(done["instance"]["name"], "DemoPack")
+        self.assertEqual(sorted(s["name"] for s in done["strategies"]),
+                         ["config", "mods"])
+
+    def test_zip_source(self):
+        self.open(self.zip_path)
+        done = self.wait_idle()
+        self.assertEqual(done["phase"], "idle")
+        self.assertEqual(done["mode"], "zip")
+        self.assertEqual(done["source"]["name"], "DemoPack-1.0.0.mrpack")
+        self.assertEqual(sorted(s["name"] for s in done["strategies"]),
+                         ["config", "mods"])
+
+    def test_any_file_inside_instance_is_enough(self):
+        """和侧边栏一样：选整合包里的任意文件也能定位。"""
+        snap = self.open(self.pack / "mods" / "a.jar")
+        self.assertEqual(snap["pending"]["name"], "DemoPack")
+        done = self.wait_idle()
+        self.assertEqual(done["mode"], "instance")
+
+    # ---- 认错了要说清 ----
+    def test_update_pack_rejected(self):
+        res = self.api.invoke("dev.open", {"path": str(self.eapack)})
+        self.assertFalse(res["ok"])
+        self.assertEqual(res["error"]["code"], "IS_UPDATE_PACK")
+        self.assertIn("更新包", res["error"]["message"])
+        self.assertEqual(self.dev()["phase"], "idle")   # 没有进入识别
+
+    def test_zip_without_index_rejected(self):
+        path = self.tmp / "curseforge.zip"
+        with zipfile.ZipFile(path, "w") as zf:
+            zf.writestr("manifest.json", "{}")
+            zf.writestr("overrides/mods/a.jar", "A")
+        res = self.api.invoke("dev.open", {"path": str(path)})
+        self.assertFalse(res["ok"])
+        self.assertEqual(res["error"]["code"], "NOT_A_PACK")
+        self.assertIn("modrinth.index.json", res["error"]["message"])
+
+    def test_bad_index_keeps_previous_source(self):
+        self.open(self.pack)
+        self.assertEqual(self.wait_idle()["mode"], "instance")
+
+        res = self.api.invoke("dev.open", {"path": str(self.bad_zip)})
+        self.assertTrue(res["ok"], res)                  # 分类过了，识别时才失败
+        done = self.wait_idle()
+        self.assertEqual(done["phase"], "error")
+        self.assertIn("modrinth.index.json", done["error"])
+        # 之前的来源还在，不会被失败拖空
+        self.assertEqual(done["mode"], "instance")
+        self.assertEqual(done["instance"]["name"], "DemoPack")
+
+    # ---- 连续拖入：后来居上 ----
+    def test_second_open_wins(self):
+        real = instance_scan.scan_instance
+
+        def slow(*a, **kw):
+            time.sleep(0.3)
+            return real(*a, **kw)
+
+        with mock.patch.object(instance_scan, "scan_instance", slow):
+            self.open(self.pack)
+            time.sleep(0.02)
+            self.open(self.pack2)
+        done = self.wait_idle()
+        self.assertEqual(done["instance"]["name"], "Second",
+                         "先开始的旧结果覆盖了后来的选择")
+
+    # ---- 识别中不许导出 ----
+    def test_export_blocked_while_loading(self):
+        real = instance_scan.scan_instance
+        with mock.patch.object(instance_scan, "scan_instance",
+                               lambda *a, **k: (time.sleep(0.3), real(*a, **k))[1]):
+            self.open(self.pack)
+            res = self.api.invoke("dev.export", {"path": str(self.tmp / "out.eapack")})
+        self.assertFalse(res["ok"])
+        self.assertIn("识别", res["error"]["message"])
+
+    # ---- 角色路由：同一个 STEP 1 ----
+    def test_pick_pack_routes_by_role(self):
+        # 玩家端：定位到整合包本体
+        res = self.api.invoke("app.pick_pack", {"path": str(self.pack)})
+        self.assertTrue(res["ok"], res)
+        self.assertEqual(res["data"]["state"]["pack"]["name"], "DemoPack")
+
+        # 开发者端：同一个调用进 dev.open（立即 loading，不等扫描）
+        self.api.invoke("app.role.set", {"role": "developer"})
+        real = instance_scan.scan_instance
+        with mock.patch.object(instance_scan, "scan_instance",
+                               lambda *a, **k: (time.sleep(0.3), real(*a, **k))[1]):
+            res = self.api.invoke("app.pick_pack", {"path": str(self.pack2)})
+        self.assertTrue(res["ok"], res)
+        self.assertEqual(res["data"]["state"]["dev"]["phase"], "loading")
+        done = self.wait_idle()
+        self.assertEqual(done["instance"]["name"], "Second")
+
+    def test_player_role_still_rejects_non_pack(self):
+        res = self.api.invoke("app.pick_pack", {"path": str(self.eapack)})
+        self.assertFalse(res["ok"])
+        self.assertEqual(res["error"]["code"], "NOT_A_PACK")
+
+    def test_drop_routes_to_dev_when_developer(self):
+        self.api.invoke("app.role.set", {"role": "developer"})
+        res = self.api.handle_drop([str(self.pack)])
+        self.assertTrue(res["ok"], res)
+        done = self.wait_idle()
+        self.assertEqual(done["instance"]["name"], "DemoPack")
+
+    def test_drop_wrong_file_reports_reason(self):
+        self.api.invoke("app.role.set", {"role": "developer"})
+        res = self.api.handle_drop([str(self.eapack)])
+        self.assertFalse(res["ok"])
+        self.assertIn("更新包", res["error"]["message"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_web_dev_specials.py b/tests/test_web_dev_specials.py
new file mode 100644
index 0000000..a419327
--- /dev/null
+++ b/tests/test_web_dev_specials.py
@@ -0,0 +1,133 @@
+"""特殊导出选项与「更新范围」的关系：默认不导出、勾了才进包、zip 来源没有这些。"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import tempfile
+import time
+import unittest
+import zipfile
+from pathlib import Path
+from unittest import mock
+
+from app.core import database as db
+from app.ui_web.api import Api
+from app.ui_web.controller import AppController
+from app.ui_web.events import EventBus
+
+
+def _write(p: Path, text: str = "x") -> None:
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(text, encoding="utf-8")
+
+
+class DevSpecialsCase(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp(prefix="pe-devspec-"))
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        dbdir = self.tmp / "db"
+        db.create_database(dbdir)
+        self._appcfg = mock.patch.object(db, "_APP_CFG", self.tmp / "app-config.json")
+        self._appcfg.start()
+        self.addCleanup(self._appcfg.stop)
+        db.set_db_path(dbdir)
+
+        self.pack = self.tmp / "versions" / "Pack"
+        _write(self.pack / "mods" / "a.jar", "A")
+        _write(self.pack / "config" / "c.toml", "c")
+        # 特殊内容
+        _write(self.pack / "optionsof.txt", "fov:90\n")
+        _write(self.pack / "mods" / "off.jar.disabled", "D")
+        _write(self.pack / "config" / "jei" / "world" / "bookmarks.ini", "B")
+        _write(self.pack / "screenshots" / "2026-01-01.png", "P")
+
+        self.zip = self.tmp / "Pack.mrpack"
+        with zipfile.ZipFile(self.zip, "w") as zf:
+            zf.writestr("modrinth.index.json", json.dumps({
+                "formatVersion": 1, "game": "minecraft", "name": "Pack",
+                "versionId": "1.0.0", "files": [],
+                "dependencies": {"minecraft": "1.20.1"}}))
+            zf.writestr("overrides/mods/a.jar", "A")
+
+        self.bus = EventBus()
+        self.ctl = AppController(self.bus)
+        self.api = Api(self.ctl, self.bus)
+        self.ctl.set_role("developer")
+
+    def dev(self) -> dict:
+        return self.api.invoke("dev.state", {})["data"]
+
+    def wait_idle(self, timeout: float = 10.0) -> dict:
+        end = time.time() + timeout
+        while time.time() < end:
+            snap = self.dev()
+            if snap["phase"] != "loading":
+                return snap
+            time.sleep(0.02)
+        self.fail(f"识别没结束：{snap}")
+
+    def open(self, path) -> dict:
+        res = self.api.invoke("dev.open", {"path": str(path)})
+        self.assertTrue(res["ok"], res)
+        return self.wait_idle()
+
+    def names(self, snap: dict) -> set[str]:
+        return {row["name"] for row in snap["strategies"]}
+
+    # ------------------------------------------------------------------
+    def test_specials_only_when_found_and_all_off(self):
+        snap = self.open(self.pack)
+        keys = [s["key"] for s in snap["specials"]]
+        self.assertEqual(keys, ["optifine", "mods-disabled", "jei", "screenshots"])
+        self.assertTrue(all(s["checked"] is False for s in snap["specials"]))
+        self.assertEqual(snap["specials"][0]["files"], 1)
+        # 默认不导出：这些内容不该出现在更新范围里
+        self.assertNotIn("optionsof.txt", self.names(snap))
+        self.assertNotIn("screenshots", self.names(snap))
+
+    def test_enabling_optifine_brings_file_into_scope(self):
+        before = self.open(self.pack)
+        files_before = before["instance"]["totals"]["files"]
+
+        snap = self.api.invoke("dev.rule.set", {"key": "optifine", "value": True})["data"]
+        self.assertIn("optionsof.txt", self.names(snap))
+        self.assertEqual(snap["instance"]["totals"]["files"], files_before + 1)
+        self.assertTrue(next(s for s in snap["specials"] if s["key"] == "optifine")["checked"])
+
+        # 关掉又回到原样（不会残留）
+        snap = self.api.invoke("dev.rule.set", {"key": "optifine", "value": False})["data"]
+        self.assertNotIn("optionsof.txt", self.names(snap))
+        self.assertEqual(snap["instance"]["totals"]["files"], files_before)
+
+    def test_enabling_screenshots_adds_row(self):
+        self.open(self.pack)
+        snap = self.api.invoke("dev.rule.set", {"key": "screenshots", "value": True})["data"]
+        self.assertIn("screenshots", self.names(snap))
+        self.assertEqual(next(s for s in snap["specials"] if s["key"] == "screenshots")["files"], 1)
+
+    def test_disabled_mod_is_not_a_row_until_enabled(self):
+        self.open(self.pack)
+        # mods 行在（普通 mod 会导出），但 .disabled 不算
+        snap = self.dev()
+        self.assertIn("mods", self.names(snap))
+        snap = self.api.invoke("dev.rule.set", {"key": "mods-disabled", "value": True})["data"]
+        mods = next(r for r in snap["strategies"] if r["name"] == "mods")
+        self.assertTrue(mods)  # 仍在
+        # 打开后文件数应该 +1
+        self.assertGreaterEqual(snap["instance"]["totals"]["files"], 2)
+
+    def test_zip_source_has_no_specials(self):
+        snap = self.open(self.zip)
+        self.assertEqual(snap["mode"], "zip")
+        self.assertEqual(snap["specials"], [])
+
+    def test_clear_drops_specials(self):
+        self.open(self.pack)
+        snap = self.api.invoke("dev.clear", {})["data"]
+        self.assertEqual(snap["specials"], [])
+        self.assertIsNone(snap["instance"])
+
+
+if __name__ == "__main__":
+    unittest.main()
